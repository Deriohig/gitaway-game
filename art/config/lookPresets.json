{
 "version": 1,
 "about": "Gitaway LOOK presets: every lighting / colour / atmosphere value of the blueprint-island proof, one preset per mood (LOOK-BRIEF phases 0-5; art/config/LOOK-BRIEF.md). Schema + ranges: lookPresets.schema.json. Colours are #RRGGBB sRGB (three.js Color.set converts them to linear). Select with ?look=<preset name>; edit live in the panel (proof page, bottom-right 'Look' panel) and Save -> paste the preset back here. The game (R3F, three r186) can import this file: the mood presets double as day-cycle keyframes.",
 "default": "Golden afternoon",
 "conventions": {
  "sun.azimuthDeg": "relative to world.config archipelago.views.full.az; 0 = sun behind the camera, +90 = camera-right, -90 = camera-left, +/-180 = behind the island. World bearing b = views.full.az + azimuthDeg, measured from +z toward +x; light direction = (sin b cos e, sin e, cos b cos e), e = elevationDeg.",
  "sky.stops": "screen-space v (0 = bottom of the frame, 1 = top) of the below / horizon / zenith colours (sky.mode 'screen').",
  "fog.anchor": "cameraTarget: near = camera->target distance + nearOffset, far = + farOffset (re-evaluated every frame, like the game's DayCycle fog).",
  "hour": "optional top-level key on a preset: the day-cycle hour it is the keyframe for (schema 'preset.hour'). The moods share one parameter set, so the game can blend neighbouring keyframes (colours lerped in linear, numbers / angles linearly; sun azimuth along the shorter arc).",
  "sky.dome": "sky.mode 'dome' (world-space, around the camera): elevation e and azimuth distance a to the sun per pixel. Horizon colour H = mix(sky.horizon, sky.sunSideHorizon, (1 - smoothstep(0, sunSideSpreadDeg, a)) * (1 - smoothstep(0, dome.sunWarmthElevDeg, |e|))); e >= 0: mix(H, sky.zenith, clamp(e / dome.zenithElevDeg, 0, 1) ^ dome.exponent); e < 0: mix(H, sky.below, smoothstep(0, dome.belowDepthDeg, -e)). Mixed in sRGB, written raw (not tone mapped), + the sky.dither.",
  "fog.skyMatch": "none = fog.color; horizon = sky.horizon; view = H (above) at e = 0 along the camera's view azimuth, re-evaluated as the camera moves. three applies the fog colour after tone mapping (raw sRGB), like the dome, so fogged clouds meet the sky's horizon exactly.",
  "sky.paint": "sky.mode 'painted': the dome sphere's shader (lib/look-core.mjs SKY_FS). Colours are display sRGB, written raw (not tone mapped). Cloud sea = puffs on the world plane y = sea.y (camera-relative projection with parallax), overhead cumulus on a plane sky.paint.cumulus.height above the camera; cell sizes in world units.",
  "cel": "N.L bands per material kind (terrain / foliage / building softness); the direct light's cast shadow multiplies after the band; shadeTint is a unit-luma multiplier on the indirect light.",
  "post.composite": "HIGH quality tier: scene -> MSAA HalfFloat target + DepthTexture -> one composite pass (ink, Neutral once on scene pixels, bloom, grade, vignette, sRGB once). LOW tier (?quality=low or enabled false): the renderer tone-maps directly."
 },
 "timeOfDay": { "keyframes": ["Soft morning", "Golden afternoon", "Dusk"], "ease": "smoothstep", "wrap": true, "about": "Look core: the mood presets are keyframes of ONE time-of-day scalar (0-24 h, preset.hour). ?hour=H and the panel's time slider blend every look value between the two neighbouring keyframes (lib/look-core.mjs presetAtHour): colours in linear, sun.azimuthDeg (and clouds.layout.clearAzDeg) along the shorter arc, numbers linearly, booleans / enums / ints from the nearer keyframe; eased with smoothstep like skyPalette.ts; wraps through midnight (Dusk -> Soft morning). This is the structure the game's day cycle would adopt (it adds a night keyframe)." },
 "dayCycle": {
  "source": "gitaway src/world/skyPalette.ts KEYS + NIGHT @ feat/idle-loop 01449a29 (verbatim; hour -> key, smoothstep blend, colours lerped in linear) and DayCycle.tsx (sun position = lightDir x 40). ?hour=H renders 'Game (current)' with the day-cycle light at hour H (sun, hemisphere, sky, fog). 'Game (current)' = this table at hour 13.",
  "sunPath": "skyPalette.ts skyAt(): day = clamp01((h - 6) / 14); daytime: az = -1.05 + 3.5 day, el = 0.28 + 0.85 sin(pi day) (radians), lightDir = (cos az cos el, sin el, sin az cos el); night (h < 5.6 or h > 21): az 0.9, el 0.95.",
  "sunDistance": 40,
  "night": { "top": "#252E48", "mid": "#3B4463", "bottom": "#5B5E7E", "fog": "#4A5070", "sun": "#9DB0D8", "sunI": 0.45, "hemiSky": "#7C88AE", "hemiGround": "#3A3944", "hemiI": 0.6 },
  "keys": [
   [0, "night"],
   [4.6, "night"],
   [6.1, { "top": "#7C91B4", "mid": "#CBB3B6", "bottom": "#F2C9A6", "fog": "#D8BFB3", "sun": "#F7C08F", "sunI": 1, "hemiSky": "#C9C6D6", "hemiGround": "#6B5E52", "hemiI": 0.85 }],
   [8.5, { "top": "#A1C2D3", "mid": "#CEE0E2", "bottom": "#F3EEE2", "fog": "#DAE5E2", "sun": "#FFF0D8", "sunI": 1.75, "hemiSky": "#DDE9EE", "hemiGround": "#7A6A55", "hemiI": 1.05 }],
   [13, { "top": "#9CC1D3", "mid": "#C9DFE3", "bottom": "#F5F0E6", "fog": "#DDE7E4", "sun": "#FFF5E4", "sunI": 1.9, "hemiSky": "#E2EDF0", "hemiGround": "#80705A", "hemiI": 1.1 }],
   [16.6, { "top": "#A6BED0", "mid": "#E1D6C7", "bottom": "#F4DDB8", "fog": "#E6DAC7", "sun": "#FFE3B5", "sunI": 1.75, "hemiSky": "#E6E2DA", "hemiGround": "#806A55", "hemiI": 1 }],
   [18.6, { "top": "#9A92B3", "mid": "#E0B4A6", "bottom": "#F2C08A", "fog": "#E1BDA3", "sun": "#FFC27F", "sunI": 1.95, "hemiSky": "#E6CFC6", "hemiGround": "#8A6E5C", "hemiI": 1 }],
   [20.1, { "top": "#5B6189", "mid": "#A3849A", "bottom": "#DC9E80", "fog": "#A48A93", "sun": "#F2A47A", "sunI": 1.15, "hemiSky": "#ABA0BE", "hemiGround": "#5E5052", "hemiI": 0.85 }],
   [21.6, "night"],
   [24, "night"]
  ]
 },
