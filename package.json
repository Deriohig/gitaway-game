{
  "name": "gitaway",
  "private": true,
  "version": "0.1.0",
  "description": "Commit code. Escape to the countryside. An ambient farming game that grows with your work.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:devtools": "vite build --mode devtools",
    "preview": "vite preview",
    "type-check": "tsc -b",
    "test": "TZ=UTC vitest run",
    "test:watch": "TZ=UTC vitest",
    "balance": "TZ=UTC vitest run --config vitest.balance.config.ts",
    "e2e": "playwright test",
    "e2e:mobile": "playwright test --project=mobile",
    "check:push": "node scripts/check-push.mjs",
    "blueprint": "node scripts/blueprint.mjs",
    "composition": "node scripts/composition.mjs",
    "water-core": "node scripts/water-core.mjs",
    "e2e:ui": "playwright test --ui",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "prepare": "git config core.hooksPath .githooks"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tauri-apps/api": "2.12.1",
    "idb-keyval": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "2.12.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
